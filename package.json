{
  "name": "degravador",
  "productName": "Degravador",
  "version": "1.0.0",
  "description": "Transcreve audiências, vídeos e áudios de WhatsApp no próprio computador, com minutagem.",
  "main": "main.js",
  "license": "MIT",
  "author": "Degravador",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.degravador.desktop",
    "productName": "Degravador",
    "copyright": "Degravador",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "renderer/**", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "extraResources": [
      { "from": "bin", "to": "bin" },
      { "from": "LICENSES", "to": "LICENSES" }
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Degravador",
      "artifactName": "Degravador-Windows-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Degravador-Mac-${arch}-${version}.${ext}"
    }
  }
}
